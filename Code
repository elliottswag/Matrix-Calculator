/**
 * @brief asks user for input to fill the allocated memory in the heap
 * @param m typedef pointer to access the data address in memory
 * @param row number of rows
 * @param col number of columns in the matrix
 */
void input_matrix(Matrix *m){
    for(int i = 0; i < m->rows; i++){
        printf("row %d: \n", i + 1);
        for(int j = 0; j < m->cols; j++){
            scanf("%lf", &m -> data[i][j]);
        }
    }
}

/**
 * @brief print matrix
 * @param pointer_mtrx pointer to the matrix
 * @param row the number of column in the matrix
 * @param col the number of row in the matrix
 */
void print_matrix(double** pointer_mtrx, int row, int col){
    for(int i = 0; i < row; i++){
        for(int j = 0; j < col; j++){
            printf("%.1f ", pointer_mtrx[i][j]);
        }
        printf("\n");
    }
}

/**
 * @brief creates a matrix using the values sent and return the pointer to the struct
 * @param row the number of row in the matrix
 * @param col the number of colum in the matrix
 * @return struct pointer to the matrix that has recently been created
 */
    Matrix* create_matrix(int row, int col){
    Matrix *mtrx = malloc(sizeof(Matrix));
    mtrx -> rows = row;
    mtrx -> cols = col;

    mtrx -> data = malloc(row * sizeof(double*));
    for(int i = 0; i < mtrx->rows; i++){
        mtrx -> data[i] = malloc(col * sizeof(double));
    }

    return mtrx;
}

